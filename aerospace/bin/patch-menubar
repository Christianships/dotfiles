#!/bin/bash
# Rebuilds the installed AeroSpace with two patches: its menu bar icon uses
# MenuBarExtra(isInserted:), so AeroSpace keeps running when macOS hides or
# removes the icon (Menu Bar > "Allow in the Menu Bar") instead of quitting,
# and the menu has no "Quit AeroSpace" item to click by accident.
#
# Builds the same version tag that's installed (so the aerospace CLI and
# config stay compatible), swaps the binary into /Applications/AeroSpace.app
# and signs it with the stable "Cream Local Signing" cert so the Accessibility
# grant survives rebuilds. Writes a marker that the guard checks; after a
# `brew upgrade` replaces the app, the guard runs this again.
set -euo pipefail

APP=/Applications/AeroSpace.app
MARKER="$APP/Contents/Resources/menubar-patched"
SRC="${TMPDIR:-/tmp}/aerospace-patch-src"
CERT=2508949128CDCBE8A33525117AFACA0BDC9E8A55 # Cream Local Signing
export PATH="/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:$PATH"

[ -e "$MARKER" ] && [ "${1:-}" != --force ] && { echo "already patched"; exit 0; }

version=$(/usr/libexec/PlistBuddy -c 'Print CFBundleShortVersionString' "$APP/Contents/Info.plist")
echo "patching AeroSpace $version"

rm -rf "$SRC"
git clone -q --depth 1 --branch "v$version" https://github.com/nikitabobko/AeroSpace.git "$SRC"
cd "$SRC"

file=Sources/AppBundle/ui/MenuBar.swift
grep -q '^    MenuBarExtra {$' "$file" || { echo "patch target not found in $file (upstream changed)" >&2; exit 1; }
sed -i '' 's/^    MenuBarExtra {$/    MenuBarExtra(isInserted: .constant(true)) {/' "$file"
# Drop the menu's "Quit AeroSpace" item (and its Cmd-Q): with the icon always
# shown, a stray click on it was quitting AeroSpace several times an hour.
perl -0pi -e 's/\n        Button\("Quit \\\(aeroSpaceAppName\)"\) \{.*?\}\.keyboardShortcut\("Q", modifiers: \.command\)//s' "$file"
grep -q 'Button("Quit' "$file" && { echo "quit item not removed from $file (upstream changed)" >&2; exit 1; }

./generate.sh --ignore-xcodeproj --ignore-cmd-help --build-version "$version" --generate-git-hash
swift build -c release --arch arm64 --product AeroSpaceApp
bin="$(swift build -c release --arch arm64 --show-bin-path)/AeroSpaceApp"

ents=$(mktemp)
codesign -d --entitlements - --xml "$APP" > "$ents" 2>/dev/null || true

was_running=0
pgrep -qf "$APP/Contents/MacOS/AeroSpace" && was_running=1
touch /tmp/aerospace-guard.pause # don't let the guard relaunch mid-swap
osascript -e 'quit app "AeroSpace"' 2>/dev/null || true
sleep 1

cp "$bin" "$APP/Contents/MacOS/AeroSpace"
touch "$MARKER"
xattr -dr com.apple.quarantine "$APP" 2>/dev/null || true
if [ -s "$ents" ]; then
  codesign --force --sign "$CERT" --entitlements "$ents" "$APP"
else
  codesign --force --sign "$CERT" "$APP"
fi
codesign --verify --strict "$APP"
rm -f "$ents" /tmp/aerospace-guard.pause

[ "$was_running" = 1 ] && open -g -a AeroSpace
echo "done: $APP patched and signed"
