#!/bin/bash
# Keeps AeroSpace running. Run every 15s by the dev.mach.aerospace LaunchAgent.
#
#   - If the installed app isn't the menu-bar-patched build (e.g. after
#     `brew upgrade` replaced it), rebuilds it with patch-menubar.
#   - If AeroSpace isn't running, relaunches it (logged to $LOG).
#   - Snapshots which workspace every window is on. A restarted AeroSpace
#     piles every window onto one workspace, so after any restart (ours or
#     anyone else's) the windows are moved back where they were.
#
# Pause it (e.g. to quit AeroSpace on purpose): touch /tmp/aerospace-guard.pause

DIR="$(cd "$(dirname "$0")" && pwd)"
APP_BIN=/Applications/AeroSpace.app/Contents/MacOS/AeroSpace
AS=/opt/homebrew/bin/aerospace
PAUSE=/tmp/aerospace-guard.pause
MARKER=/Applications/AeroSpace.app/Contents/Resources/menubar-patched
PATCH_LOCK=/tmp/aerospace-guard.patching
PATCH_LOG=/tmp/aerospace-guard.patch.log
SNAP=/tmp/aerospace-guard.windows # line 1: pid, line 2: focused workspace, then "window-id workspace"
LOG=/tmp/aerospace-guard.log

[ -e "$PAUSE" ] && exit 0

log() { echo "$(date '+%F %T') $*" >> "$LOG"; }
server_pid() { /usr/bin/pgrep -f "$APP_BIN" | head -1; }
wait_for_server() {
  for _ in $(seq 20); do "$AS" list-workspaces --focused >/dev/null 2>&1 && break; sleep 0.5; done
  sleep 2 # let it finish discovering windows
}

# Rebuild at most once an hour per failure, in the background (takes ~1 min).
if [ ! -e "$MARKER" ] && [ ! -e "$PATCH_LOCK" ]; then
  if [ ! -e "$PATCH_LOG" ] || [ $(( $(date +%s) - $(stat -f %m "$PATCH_LOG") )) -gt 3600 ]; then
    ( touch "$PATCH_LOCK"; "$DIR/patch-menubar" > "$PATCH_LOG" 2>&1; rm -f "$PATCH_LOCK" ) &
  fi
fi

pid=$(server_pid)
if [ -z "$pid" ]; then
  [ -e "$PATCH_LOCK" ] && exit 0 # patch-menubar relaunches it when done
  log "AeroSpace not running, relaunching"
  /usr/bin/open -g -a AeroSpace
  wait_for_server
  pid=$(server_pid)
  [ -z "$pid" ] && { log "relaunch failed"; exit 0; }
fi

# A different pid than the snapshot means AeroSpace restarted. Put windows
# back, but only from a snapshot taken this boot (window ids reset on reboot).
if [ -s "$SNAP" ] && [ "$(head -1 "$SNAP")" != "$pid" ]; then
  boot=$(sysctl -n kern.boottime | sed -E 's/.*sec = ([0-9]+).*/\1/')
  if [ "$(stat -f %m "$SNAP")" -gt "$boot" ]; then
    wait_for_server
    n=0
    while read -r wid ws; do
      "$AS" move-node-to-workspace --window-id "$wid" "$ws" 2>/dev/null && n=$((n + 1))
    done < <(tail -n +3 "$SNAP")
    focused=$(sed -n 2p "$SNAP")
    [ -n "$focused" ] && "$AS" workspace "$focused" 2>/dev/null
    log "AeroSpace restarted (pid $(head -1 "$SNAP") -> $pid), restored $n windows"
  fi
fi

# Snapshot the current layout (atomically, and only if the server answered).
focused=$("$AS" list-workspaces --focused 2>/dev/null) || exit 0
windows=$("$AS" list-windows --all --format '%{window-id} %{workspace}' 2>/dev/null) || exit 0
printf '%s\n%s\n%s\n' "$pid" "$focused" "$windows" > "$SNAP.tmp" && mv "$SNAP.tmp" "$SNAP"
exit 0
