//   _____ _____ _____ _____ _____ _____ _____ _____ _____ 
//  |   __|  _  |   __|_   _|   __|   __|_   _|     |  |  |
//  |   __|     |__   | | | |   __|   __| | | |   --|     |
//  |__|  |__|__|_____| |_| |__|  |_____| |_| |_____|__|__|  GROUPS
//
//  by Bina

  
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    // jet (purple gradient), same art as the Mach screensaver. The spider is
    // txt/spider2.txt; strawberry man lives in strawberry.jsonc:
    //   fastfetch -c ~/.config/fastfetch/strawberry.jsonc
    "source": "~/.config/fastfetch/txt/jet.txt",
    "color" : {
     "1" : "38;2;236;196;255",
     "2" : "38;2;218;166;255",
     "3" : "38;2;200;138;252",
     "4" : "38;2;182;112;244",
     "5" : "38;2;164;92;234",
     "6" : "38;2;146;76;222"
   },
   "padding" : {
    "left": 2
   }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;168;85;247",
      "output": "38;2;236;228;251"
    },
    "percent": {
      "type": 3,
      "color": {
        "green": "38;2;183;157;255",
        "yellow": "38;2;255;212;121",
        "red": "38;2;255;107;138"
      }
    },
    "bar": {
      "width": 13,
      "char": {
        "elapsed": "▬",
        "total": "-"
      },
      "border": {
        "left": "[ ",
        "right": " ]"
      },
      "color": {
        "elapsed": "38;2;200;138;252",
        "total": "38;2;124;106;156",
        "border": "38;2;124;106;156"
      }
    },
    "key": {
      "width": 0
    }
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "{#38;2;124;106;156}╭─→ {#1;38;2;201;164;255}󰌢 HARDWARE {#38;2;124;106;156}●─────────────────────────────╮"
    },
    {
      "type": "host",
      "key": "{#38;2;124;106;156}│ {#38;2;168;85;247}󰌢",
      "format": "{name}"
    },
    {
      "type": "cpuusage",
      "key": "{#38;2;124;106;156}│ {#38;2;168;85;247}󰻠",
      "format": "{#38;2;124;106;156}CPU  {avg-bar} {#38;2;168;85;247}{avg}"
    },
    {
      "type": "gpu",
      "key": "{#38;2;124;106;156}│ {#38;2;168;85;247}󰢮",
      "driverSpecific": true,
      "format": "{#38;2;124;106;156}GPU  {core-usage-bar} {#38;2;168;85;247}{core-usage-num}"
    },
    {
      "type": "memory",
      "key": "{#38;2;124;106;156}│ {#38;2;168;85;247}󰍛",
      "format": "{#38;2;124;106;156}RAM  {percentage-bar} {#38;2;168;85;247}{percentage}"
    },
    {
      "type": "disk",
      "key": "{#38;2;124;106;156}│ {#38;2;168;85;247}󰋊",
      "folders": "/",
      "format": "{#38;2;124;106;156}SSD  {size-percentage-bar} {#38;2;168;85;247}{size-percentage}"
    },
    {
      "type": "command",
      "key": "{#38;2;124;106;156}│ {#38;2;168;85;247}󰔏",
      "text": "printf '\\033[38;2;124;106;156mTMP\\033[0m  '; ~/.config/fastfetch/scripts/tempbar.sh"
    },
    {
      "type": "custom",
      "format": "{#38;2;124;106;156}╰────────────────────────────────────────────╯"
    },
    "break",
    {
      "type": "custom",
      "format": "{#38;2;124;106;156}╭─→ {#1;38;2;201;164;255} SOFTWARE {#38;2;124;106;156}●─────────────────────────────╮"
    },
    {
      "type": "os",
      "key": "{#38;2;124;106;156}│ {#38;2;168;85;247}"
    },
    {
      "type": "kernel",
      "key": "{#38;2;124;106;156}│ {#38;2;168;85;247}󰒓"
    },
    {
      "type": "shell",
      "key": "{#38;2;124;106;156}│ {#38;2;168;85;247}"
    },
    {
      "type": "command",
      "key": "{#38;2;124;106;156}│ {#38;2;168;85;247}󰊠",
      "text": "printf 'Ghostty %s' \"$(/Applications/Ghostty.app/Contents/MacOS/ghostty +version 2>/dev/null | awk 'NR==1{print $2}')\""
    },
    {
      "type": "command",
      "key": "{#38;2;124;106;156}│ {#38;2;168;85;247}",
      "text": "printf 'AeroSpace %s' \"$(aerospace --version 2>/dev/null | awk 'NR==1{print $5}')\""
    },
    {
      "type": "command",
      "key": "{#38;2;124;106;156}│ {#38;2;168;85;247}",
      "text": "nvim --version | awk 'NR==1{sub(/^v/,\"\",$2); print \"Neovim \" $2}'"
    },
    {
      "type": "uptime",
      "key": "{#38;2;124;106;156}│ {#38;2;168;85;247}󰅐"
    },
    {
      "type": "custom",
      "format": "{#38;2;124;106;156}╰────────────────────────────────────────────╯"
    },
    "break"
  ]
}
