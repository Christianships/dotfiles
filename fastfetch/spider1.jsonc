//   _____ _____ _____ _____ _____ _____ _____ _____ _____ 
//  |   __|  _  |   __|_   _|   __|   __|_   _|     |  |  |
//  |   __|     |__   | | | |   __|   __| | | |   --|     |
//  |__|  |__|__|_____| |_| |__|  |_____| |_| |_____|__|__|  GROUPS
//
//  by Bina

  
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    // spider (purple gradient). strawberry man lives in strawberry.jsonc:
    //   fastfetch -c ~/.config/fastfetch/strawberry.jsonc
    "source": "~/.config/fastfetch/txt/spider.txt",
    "color" : {
     "1" : "38;2;236;196;255",
     "2" : "38;2;218;166;255",
     "3" : "38;2;200;138;252",
     "4" : "38;2;182;112;244",
     "5" : "38;2;164;92;234",
     "6" : "38;2;146;76;222"
   },
   "padding" : {
    "left": 2
   }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;168;85;247",
      "output": "38;2;236;228;251"
    },
    "percent": {
      "type": 9,
      "color": {
        "green": "38;2;183;157;255",
        "yellow": "38;2;255;212;121",
        "red": "38;2;255;107;138"
      }
    },
    "key": {
      "width": 0
    }
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "{#38;2;124;106;156}╭─→ {#1;38;2;201;164;255}󰌢 HARDWARE {#38;2;124;106;156}●─────────────────────────────╮"
    },
    {
      "type": "host",
      "key": "{#38;2;124;106;156}│ {#38;2;168;85;247}󰌢",
      "format": "{name}"
    },
    {
      "type": "cpu",
      "key": "{#38;2;124;106;156}│ {#38;2;168;85;247}"
    },
    {
      "type": "gpu",
      "key": "{#38;2;124;106;156}│ {#38;2;168;85;247}󰢮",
      "format": "{name} ({core-count} cores) [{type}]"
    },
    {
      "type": "memory",
      "key": "{#38;2;124;106;156}│ {#38;2;168;85;247}󰍛"
    },
    {
      "type": "disk",
      "key": "{#38;2;124;106;156}│ {#38;2;168;85;247}󰋊",
      "folders": "/",
      "format": "{size-used} / {size-total} ({size-percentage}) - {filesystem}"
    },
    {
      "type": "custom",
      "format": "{#38;2;124;106;156}╰────────────────────────────────────────────╯"
    },
    "break",
    {
      "type": "custom",
      "format": "{#38;2;124;106;156}╭─→ {#1;38;2;201;164;255} SOFTWARE {#38;2;124;106;156}●─────────────────────────────╮"
    },
    {
      "type": "os",
      "key": "{#38;2;124;106;156}│ {#38;2;168;85;247}"
    },
    {
      "type": "kernel",
      "key": "{#38;2;124;106;156}│ {#38;2;168;85;247}󰒓"
    },
    {
      "type": "shell",
      "key": "{#38;2;124;106;156}│ {#38;2;168;85;247}"
    },
    {
      "type": "command",
      "key": "{#38;2;124;106;156}│ {#38;2;168;85;247}󰊠",
      "text": "printf 'Ghostty %s' \"$(/Applications/Ghostty.app/Contents/MacOS/ghostty +version 2>/dev/null | awk 'NR==1{print $2}')\""
    },
    {
      "type": "command",
      "key": "{#38;2;124;106;156}│ {#38;2;168;85;247}",
      "text": "printf 'AeroSpace %s' \"$(aerospace --version 2>/dev/null | awk 'NR==1{print $5}')\""
    },
    {
      "type": "command",
      "key": "{#38;2;124;106;156}│ {#38;2;168;85;247}",
      "text": "nvim --version | awk 'NR==1{sub(/^v/,\"\",$2); print \"Neovim \" $2}'"
    },
    {
      "type": "uptime",
      "key": "{#38;2;124;106;156}│ {#38;2;168;85;247}󰅐"
    },
    {
      "type": "custom",
      "format": "{#38;2;124;106;156}╰────────────────────────────────────────────╯"
    },
    "break"
  ]
}
