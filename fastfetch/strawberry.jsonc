{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/txt/strawberryKat.txt",
    "color" : {
     "1" : "magenta" 
   },
   "padding" : {
    "left": 2
   }
  },
  "display": {
        "separator": " ➜  "
  },
  "modules": [
      "break",
      "break",
      "break",
       {
          "type": "os",
          "key": "OS   ",
          "keyColor": "35"  // = color1
      },
      {
          "type": "kernel",
          "key": " ├  ",
          "keyColor": "35"
      },
      {
          "type": "packages",
          "format": "{}",
          "key": " ├ 󰏖 ",
          "keyColor": "35"  
      },
      {
          "type": "shell",
          "key": " └  ",
          "keyColor": "35" 
      },
      "break",
      {
          "type": "wm",
          "key": "WM   ",
          "keyColor": "35" 
      },
      {
          "type": "wmtheme",
          "key": " ├ 󰉼 ",
          "keyColor": "35"
      },
      {
          "type": "icons",
          "key": " ├ 󰀻 ",
          "keyColor": "35"
      },
      {
          "type": "cursor",
          "key": " ├  ",
          "keyColor": "35" 
      },
      {
          "type": "terminal",
          "key": " ├  ",
          "keyColor": "35"
      },
      {
          "type": "terminalfont",
          "key": " └  ",
          "keyColor": "35" 
      },
      "break",
      {
          "type": "host",
          "format": "{5} {1} Type {2}",
          "key": "PC   ",
          "keyColor": "35"
      },
      {
          "type": "cpu",
          "format": "{1} ({3}) @ {7} GHz",
          "key": " ├  ",
          "keyColor": "35"
      },
      {
          "type": "gpu",
          "format": "{1} {2} @ {12} GHz",            
          "key": " ├ 󰢮 ",
            "keyColor": "35"
      },
      {
          "type": "memory",
          "key": " ├  ",
          "keyColor": "35"
      },
      {
          "type": "swap",
          "key": " ├ 󰓡 ",
          "keyColor": "35"
      },
      {
          "type": "disk",
          "key": " ├ 󰋊 ",
          "keyColor": "35"
      },
      "break",
      "break"
  ]
}
