# Ghostty readability profile for long AI replies.
# On macOS, Ghostty may also merge:
# ~/Library/Application Support/com.mitchellh.ghostty/config.ghostty

# Liquid glass, tuned for readable text over transparency.
# Plain blur, not macos-glass-*: Apple's glass effect deliberately goes flat and
# gray when its window loses focus, so unfocused windows looked different.
# This blur looks the same focused or not. 20 = Ghostty's default radius.
background-blur = 20
background-opacity = 0.86
macos-titlebar-style = hidden
background = #0b0713
foreground = #ece4fb

# Font and spacing.
font-family = JetBrainsMono Nerd Font
font-size = 15
font-thicken = true
adjust-cell-height = 8%
window-padding-x = 16
window-padding-y = 12
window-padding-balance = true

# Cursor and selection.
cursor-style = block
# Cursor shaders need this OFF. A blinking cursor resets the shader's cursor
# state on every blink, so trails/smears never get to play out -- they flicker
# or never appear at all. Set back to true if you drop cursor shaders.
cursor-style-blink = false
cursor-color = #c9a4ff
cursor-text = #140d20
# Stop shell integration from swapping in a thin/hollow cursor at the
# zsh prompt — keep the real block+blink cursor everywhere, including
# inside TUI apps like Claude Code.
shell-integration-features = no-cursor
# Hide the mouse pointer as soon as you type, so it stops sitting in the middle
# of the text while you navigate nvim. A trackpad/mouse move brings it back.
mouse-hide-while-typing = true

# Left Option acts as Alt, so the shell's word keys work (Option+B/F jump a
# word, Option+Backspace erases one). Right Option still types special
# characters like é and ™.
macos-option-as-alt = left

selection-background = #3a2a5c
selection-foreground = #ece4fb
minimum-contrast = 3

# Keep inactive splits visible without making them compete for attention.
# 1 = unfocused splits are not dimmed at all; they look identical to the focused one.
unfocused-split-opacity = 1
# Pane workflow for working beside a running agent.
# Command is left untouched for macOS/Ghostty defaults like Cmd+Enter fullscreen.
# Ghostty sees your remapped Fn/Ctrl key as logical Control for these bindings.
# Horizontal panel below: Ctrl+Shift+Enter. Side panel: Ctrl+Enter.
# Switch panels: Ctrl+Alt+arrows, or Ctrl+[ / Ctrl+]. Zoom current panel: Ctrl+Shift+Z.
keybind = ctrl+enter=new_split:right
keybind = ctrl+shift+enter=new_split:down
keybind = ctrl+alt+arrow_up=goto_split:up
keybind = ctrl+alt+arrow_down=goto_split:down
keybind = ctrl+alt+arrow_left=goto_split:left
keybind = ctrl+alt+arrow_right=goto_split:right
keybind = ctrl+[=goto_split:previous
keybind = ctrl+]=goto_split:next
keybind = ctrl+shift+z=toggle_split_zoom

# Git changes panel helper: Ctrl+Shift+G opens a bottom panel; then run `lg`.
# `lg` starts lazygit if installed, otherwise falls back to git status + diff.
keybind = ctrl+shift+g=new_split:down

# High-contrast ANSI colors for AI CLIs, git, shells, and Markdown renderers.
palette = 0=#1c1430
palette = 1=#ff6b8a
palette = 2=#6ee7a0
palette = 3=#ffd479
palette = 4=#b79dff
palette = 5=#a855f7
palette = 6=#5ee6e6
palette = 7=#c7b8e6
palette = 8=#4a3d63
palette = 9=#ff8fa3
palette = 10=#8df3b8
palette = 11=#ffe3a0
palette = 12=#c9a4ff
palette = 13=#e879f9
palette = 14=#8ff5f5
palette = 15=#ece4fb

confirm-close-surface = false

# ── SHADERS ──────────────────────────────────────────────────
# The active shader lives in its own file so `gshader` can swap one line
# without rewriting this config. `gshader` lists/cycles/picks; Cmd+Shift+,
# reloads. Shaders themselves are in ./shaders/.
config-file = shader.conf
# `true` animates only while the window is focused. `always` kept redrawing
# every frame even in the background, which pinned the GPU for no visible gain.
custom-shader-animation = true
